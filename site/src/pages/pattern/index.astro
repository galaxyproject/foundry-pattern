---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const entries = await getCollection("docs", (entry) => entry.data.section === "pattern");

function patternPage(slug: string) {
  const entry = entries.find((candidate) => candidate.id === `pattern/${slug}`);
  if (!entry) throw new Error(`Missing Pattern page: ${slug}`);

  return {
    href: `${base}/${entry.id}/`,
    title: entry.data.title,
    description: entry.data.description,
  };
}

const startHere = [
  {
    ...patternPage("story"),
    summary: "Why handwritten skills rot—and why the knowledge base should be the source.",
  },
  {
    ...patternPage("the-model"),
    summary: "The four parts: Knowledge Base, Mold, Cast, and Provenance.",
  },
  {
    ...patternPage("guiding-principles"),
    summary: "The disciplines that keep a Foundry trustworthy as its domain and tooling change.",
  },
  {
    ...patternPage("principles-in-action"),
    summary: "How two Foundries turn the principles into validators, schemas, and checks.",
  },
];

const buildOne = [
  {
    ...patternPage("anatomy-of-an-instance"),
    summary: "The shared substrate—and the boundary of each domain's extension surface.",
  },
  {
    ...patternPage("setting-up-a-foundry"),
    summary: "A stack-neutral route for making those domain-specific decisions.",
  },
  {
    ...patternPage("standing-up-a-foundry"),
    summary: "How the Astro stack makes each invariant concrete.",
  },
];

const reference = [
  {
    ...patternPage("astro-stack-glossary"),
    summary: "Terms specific to the worked implementation.",
  },
  {
    ...patternPage("kind-catalog"),
    summary: "The content kinds defined by both instances.",
  },
  {
    ...patternPage("tag-catalog"),
    summary: "The controlled vocabularies used by both instances.",
  },
  {
    ...patternPage("design-records"),
    summary: "How content/meta documents the Foundry itself—and routes changes to their owner.",
  },
  {
    ...patternPage("glossary"),
    summary: "Canonical definitions for the pattern.",
  },
];
---
<Base
  title="The Pattern"
  description="Turn living domain knowledge into skills agents can trust."
>
  <div class="pattern-landing">
    <section class="hero" aria-labelledby="pattern-title">
      <div class="hero-copy">
        <p class="kicker">The Pattern</p>
        <h1 id="pattern-title">Turn living domain knowledge into skills agents can trust.</h1>
        <p class="hero-deck">
          A Foundry keeps knowledge readable and reviewable by people, then compiles the
          right slices into frozen, traceable artifacts for agents. When the source
          changes, you recast&mdash;rather than hand-editing another skill.
        </p>
        <div class="hero-actions">
          <a class="primary-action" href={startHere[0].href}>Read the story <span aria-hidden="true">&rarr;</span></a>
          <a class="text-action" href={startHere[1].href}>See the model <span aria-hidden="true">&rarr;</span></a>
        </div>
      </div>

      <figure class="machine" aria-labelledby="machine-caption">
        <div class="machine-source">
          <span class="machine-label">Source of truth</span>
          <strong>Knowledge base</strong>
          <span>readable · linked · checked</span>
          <div class="machine-mold">
            <span class="machine-label">One action</span>
            <strong>Mold</strong>
            <span>typed references + procedure</span>
          </div>
        </div>

        <div class="machine-cast" aria-hidden="true">
          <b>&darr;</b>
          <span>cast</span>
          <b>&darr;</b>
        </div>

        <div class="machine-output">
          <div class="machine-artifact">
            <span class="machine-label">For the agent</span>
            <strong>Frozen skill</strong>
            <span>small · portable · self-contained</span>
          </div>
          <div class="machine-provenance">
            <span class="machine-label">Lineage record</span>
            <strong>Provenance</strong>
            <span>source · target · references · checks</span>
          </div>
        </div>

        <figcaption id="machine-caption">
          Author the knowledge once. Recast each artifact when the source moves.
        </figcaption>
      </figure>
    </section>

    <section class="route-section" aria-labelledby="start-here-title">
      <div class="section-heading">
        <div>
          <p class="section-label">Recommended route</p>
          <h2 id="start-here-title">Start here</h2>
        </div>
        <p>Four focused reads: the problem, the machine, the discipline, and the proof.</p>
      </div>

      <ol class="route-list">
        {startHere.map((entry, index) => (
          <li>
            <a href={entry.href}>
              <span class="route-number">{String(index + 1).padStart(2, "0")}</span>
              <span class="route-copy">
                <strong>{entry.title}</strong>
                <span>{entry.summary}</span>
              </span>
              <span class="route-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="secondary-sections">
      <section class="link-section" aria-labelledby="build-one-title">
        <p class="section-label">From pattern to practice</p>
        <h2 id="build-one-title">Build one</h2>
        <p class="section-intro">
          See what the pattern supplies, make the domain-specific decisions, then follow
          one implementation end to end.
        </p>
        <ul class="link-list">
          {buildOne.map((entry, index) => (
            <li>
              <a href={entry.href}>
                <span class="link-index">{String(index + 1).padStart(2, "0")}</span>
                <span>
                  <strong>{entry.title}</strong>
                  <small>{entry.summary}</small>
                </span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="link-section reference-section" aria-labelledby="reference-title">
        <p class="section-label">Look something up</p>
        <h2 id="reference-title">Reference</h2>
        <p class="section-intro">
          The implementation vocabulary, generated catalogs, design records, and canonical definitions.
        </p>
        <ul class="reference-list">
          {reference.map((entry) => (
            <li>
              <a href={entry.href}>
                <span>
                  <strong>{entry.title}</strong>
                  <small>{entry.summary}</small>
                </span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .pattern-landing {
    padding-top: clamp(1.5rem, 4vw, 3.5rem);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.18fr) minmax(20rem, 0.82fr);
    gap: clamp(2.5rem, 7vw, 5.5rem);
    align-items: center;
    padding-bottom: clamp(4.5rem, 9vw, 7rem);
  }

  .hero h1 {
    max-width: 13ch;
    margin-top: 0.65rem;
    font-size: clamp(3.25rem, 7vw, 5.35rem);
    line-height: 0.94;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero-deck {
    max-width: 36rem;
    margin-top: 1.6rem;
    color: var(--steel);
    font-size: clamp(1.06rem, 1.4vw, 1.2rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.4rem;
    margin-top: 2rem;
  }

  .primary-action,
  .text-action {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease,
      transform 180ms ease, box-shadow 180ms ease;
  }

  .primary-action {
    min-height: 3rem;
    padding: 0.7rem 1.1rem;
    color: var(--soot);
    background: var(--ember);
    border: 1px solid var(--glow);
    border-radius: 0.35rem;
    box-shadow: 0 14px 30px -18px rgba(226, 85, 43, 0.95);
  }

  .primary-action:hover {
    color: var(--soot);
    background: var(--glow);
    transform: translateY(-2px);
  }

  .text-action {
    color: var(--steel);
  }

  .text-action:hover {
    color: var(--glow);
    transform: translateX(2px);
  }

  .primary-action:active,
  .text-action:active {
    transform: translateY(1px);
  }

  .primary-action:focus-visible,
  .text-action:focus-visible,
  .route-list a:focus-visible,
  .link-list a:focus-visible,
  .reference-list a:focus-visible {
    outline: 2px solid var(--glow);
    outline-offset: 4px;
  }

  .machine {
    position: relative;
    margin: 1rem 0 0;
    padding: 1.15rem;
    overflow: hidden;
    background:
      linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px),
      var(--soot);
    background-size: 1.25rem 1.25rem;
    border: 1px solid var(--rule);
    border-radius: 0.8rem;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 36px 70px -48px rgba(226, 85, 43, 0.75);
  }

  .machine::before {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    content: "";
    background: var(--molten);
  }

  .machine-source,
  .machine-artifact,
  .machine-provenance {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 1rem;
    background: var(--iron);
    border: 1px solid var(--rule);
    border-radius: 0.5rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
  }

  .machine-source > strong,
  .machine-artifact > strong,
  .machine-provenance > strong,
  .machine-mold > strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.16rem;
    line-height: 1.15;
  }

  .machine-source > span:last-of-type,
  .machine-artifact > span:last-of-type,
  .machine-provenance > span:last-of-type,
  .machine-mold > span:last-of-type {
    color: var(--ash);
    font-size: 0.76rem;
  }

  .machine-label {
    color: var(--ember);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .machine-mold {
    display: flex;
    flex-direction: column;
    gap: 0.18rem;
    margin-top: 1rem;
    padding: 0.85rem 0.9rem 0.85rem 1rem;
    background: var(--graphite);
    border-left: 3px solid var(--ember);
  }

  .machine-cast {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 0.4rem;
    padding: 0.42rem 0 0.34rem;
    color: var(--ember);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .machine-cast b {
    justify-self: center;
    font-size: 1rem;
    line-height: 1;
    text-shadow: 0 0 10px rgba(226, 85, 43, 0.75);
  }

  .machine-output {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.65rem;
  }

  .machine-artifact {
    border-color: var(--ember);
  }

  .machine-provenance {
    border-style: dashed;
  }

  .machine figcaption {
    padding: 0.9rem 0.35rem 0.1rem;
    color: var(--ash);
    font-size: 0.72rem;
    line-height: 1.45;
    text-align: center;
  }

  .route-section {
    padding: clamp(3rem, 7vw, 5rem) 0;
    border-top: 1px solid var(--rule);
  }

  .section-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(18rem, 1fr);
    gap: 2rem;
    align-items: end;
    margin-bottom: 1.75rem;
  }

  .section-label {
    margin-bottom: 0.4rem;
    color: var(--ember);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .section-heading h2,
  .link-section h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    letter-spacing: -0.02em;
  }

  .section-heading > p,
  .section-intro {
    max-width: 34rem;
    color: var(--ash);
    font-size: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .route-list,
  .link-list,
  .reference-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .route-list {
    background: var(--iron);
    border: 1px solid var(--rule);
    border-radius: 0.7rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
  }

  .route-list li + li {
    border-top: 1px solid var(--rule);
  }

  .route-list a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto;
    gap: 1.2rem;
    align-items: center;
    padding: 1.3rem 1.4rem;
    color: inherit;
    text-decoration: none;
    transition: background 180ms ease, transform 180ms ease;
  }

  .route-list a:hover {
    background: var(--graphite);
    transform: translateX(4px);
  }

  .route-number,
  .link-index {
    color: var(--ember);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
  }

  .route-copy {
    display: grid;
    grid-template-columns: minmax(10rem, 0.48fr) minmax(0, 1fr);
    gap: 1rem 2rem;
    align-items: baseline;
  }

  .route-copy strong,
  .link-list strong,
  .reference-list strong {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
  }

  .route-copy > span {
    color: var(--ash);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .route-arrow {
    color: var(--ember);
    font-size: 1.3rem;
    transition: transform 180ms ease;
  }

  .route-list a:hover .route-arrow {
    transform: translateX(3px);
  }

  .secondary-sections {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(18rem, 0.85fr);
    gap: 1px;
    overflow: hidden;
    background: var(--rule);
    border: 1px solid var(--rule);
    border-radius: 0.7rem;
  }

  .link-section {
    padding: clamp(1.5rem, 4vw, 2.5rem);
    background: var(--iron);
  }

  .section-intro {
    min-height: 4.8rem;
    margin-top: 0.8rem;
  }

  .link-list,
  .reference-list {
    margin-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .link-list li,
  .reference-list li {
    border-bottom: 1px solid var(--rule);
  }

  .link-list a,
  .reference-list a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: start;
    padding: 1.15rem 0.5rem;
    color: var(--ember);
    text-decoration: none;
    transition: color 180ms ease, padding 180ms ease;
  }

  .reference-list a {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .link-list a:hover,
  .reference-list a:hover {
    padding-right: 0;
    padding-left: 0.8rem;
    color: var(--glow);
  }

  .link-list a > span:nth-child(2),
  .reference-list a > span:first-child {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .link-list small,
  .reference-list small {
    display: -webkit-box;
    overflow: hidden;
    color: var(--ash);
    font-size: 0.78rem;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  @media (max-width: 52rem) {
    .hero {
      grid-template-columns: 1fr;
    }

    .hero h1 {
      max-width: 14ch;
    }

    .machine {
      max-width: 36rem;
      margin-top: 0;
    }

    .section-heading,
    .secondary-sections {
      grid-template-columns: 1fr;
    }

    .section-heading {
      gap: 0.75rem;
    }

    .section-intro {
      min-height: auto;
    }
  }

  @media (max-width: 38rem) {
    .pattern-landing {
      padding-top: 1rem;
    }

    .hero {
      gap: 2.5rem;
    }

    .hero h1 {
      font-size: clamp(2.75rem, 14vw, 4rem);
    }

    .machine-output,
    .route-copy {
      grid-template-columns: 1fr;
    }

    .route-list a {
      grid-template-columns: 2rem minmax(0, 1fr) auto;
      gap: 0.7rem;
      padding: 1.15rem 0.9rem;
    }

    .route-copy {
      gap: 0.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .primary-action,
    .text-action,
    .route-list a,
    .route-arrow,
    .link-list a,
    .reference-list a {
      transition: none;
    }
  }
</style>
